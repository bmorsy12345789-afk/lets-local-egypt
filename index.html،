
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover Egypt with local eyes. Private tours to the Pyramids of Giza, Saqqara, Cairo, Alexandria and Fayoum.">
  <title>Let's Local Egypt | Explore Egypt by Local Eyes</title>
  <style>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #24302c;
      line-height: 1.6;
      background: #fffdf8;
    }
    header {
      background: #173c32;
      color: white;
      padding: 18px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .logo { font-size: 22px; font-weight: bold; }
    nav { display: flex; gap: 18px; flex-wrap: wrap; }
    nav a { color: white; text-decoration: none; }
    .hero {
      min-height: 490px;
      padding: 90px 7%;
      color: white;
      display: flex;
      align-items: center;
      background:
        linear-gradient(90deg, rgba(0,0,0,.72), rgba(0,0,0,.12)),
        url("https://images.unsplash.com/photo-1503177119275-0aa32b3a9368?auto=format&fit=crop&w=1800&q=85")
        center/cover;
    }
    .hero-content { max-width: 650px; }
    .hero h1 { font-size: clamp(38px, 7vw, 66px); line-height: 1.1; margin: 0 0 20px; }
    .hero p { font-size: 19px; }
    .button {
      display: inline-block;
      background: #d7a84b;
      color: #172b24;
      text-decoration: none;
      font-weight: bold;
      padding: 12px 22px;
      border-radius: 5px;
      margin: 10px 8px 0 0;
    }
    section { padding: 60px 7%; }
    .section-title { text-align: center; margin-bottom: 32px; }
    .section-title h2 { font-size: 32px; color: #173c32; margin-bottom: 8px; }
    .section-title p { color: #65716a; }
    .intro { max-width: 850px; margin: auto; text-align: center; }
    .tours {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 24px;
    }
    .tour {
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 18px #00000012;
    }
    .tour img { width: 100%; height: 210px; object-fit: cover; display: block; }
    .tour-content { padding: 20px; }
    .tour h3 { color: #173c32; margin-top: 0; }
    .tour a { color: #956b19; font-weight: bold; text-decoration: none; }
    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 22px;
      text-align: center;
    }
    .feature {
      background: #f4f0e6;
      border-radius: 8px;
      padding: 24px 16px;
    }
    .feature span { font-size: 32px; }
    #contact { background: #173c32; color: white; text-align: center; }
    #contact h2 { font-size: 32px; }
    footer {
      background: #102a23;
      color: #e8eee9;
      text-align: center;
      padding: 22px;
      font-size: 14px;
    }
    @media (max-width: 600px) {
      header { justify-content: center; }
      nav { justify-content: center; gap: 12px; }
      .hero { padding: 65px 6%; min-height: 430px; }
      section { padding: 45px 6%; }
    }
  </style>
</head>
<body>

<header>
  <div class="logo">Let's Local Egypt</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#tours">Our Tours</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

